{
  "title": "三次函数的单调性与极值",
  "problem_type": "monotonic_extremum",
  "scenes": [
    {
      "id": 1,
      "template": "title_card",
      "params": {
        "text": "求 f(x) = x^3 - 3x 的单调区间与极值",
        "subtitle": "导数工具",
        "duration": 3.5
      }
    },
    {
      "id": 2,
      "template": "axes_plot",
      "params": {
        "x_range": [-2.5, 2.5, 1],
        "y_range": [-4, 4, 1],
        "functions": [
          { "expr": "x**3 - 3*x", "label": "f(x) = x^3 - 3x", "color": "BLUE" }
        ],
        "caption": "先画出 f(x) = x^3 - 3x 的图像",
        "duration": 6.0
      }
    },
    {
      "id": 3,
      "template": "step_card",
      "params": {
        "mode": "stack",
        "duration": 12.0,
        "steps": [
          {
            "text": "求导",
            "formula_latex": "f'(x) = 3x^2 - 3 = 3(x+1)(x-1)"
          },
          {
            "text": "令 f'(x) = 0，得驻点",
            "formula_latex": "x = -1,\\quad x = 1"
          },
          {
            "text": "列表判断符号：x < -1 时 f' > 0，-1 < x < 1 时 f' < 0，x > 1 时 f' > 0",
            "formula_latex": "f(-1) = 2,\\quad f(1) = -2"
          },
          {
            "text": "得单调区间与极值",
            "formula_latex": "\\nearrow (-\\infty,-1),\\ \\searrow (-1,1),\\ \\nearrow (1,+\\infty)"
          }
        ]
      }
    },
    {
      "id": 4,
      "template": "summary_card",
      "params": {
        "title": "答案",
        "points": [
          "增区间：(-∞, -1) 和 (1, +∞)",
          "减区间：(-1, 1)",
          "极大值 f(-1) = 2，极小值 f(1) = -2"
        ],
        "duration": 4.5
      }
    }
  ]
}
