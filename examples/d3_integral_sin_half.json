{
  "title": "定积分：正弦半波的面积",
  "problem_type": "definite_integral",
  "scenes": [
    {
      "id": 1,
      "template": "title_card",
      "params": {
        "text": "求 y = sin x 在 [0, pi] 与 x 轴围成的面积",
        "subtitle": "半波面积",
        "duration": 3.5
      }
    },
    {
      "id": 2,
      "template": "area_under_curve",
      "params": {
        "x_range": [-0.5, 3.7, 1],
        "y_range": [-0.3, 1.3, 0.5],
        "expr": "sin(x)",
        "a": 0.0,
        "b": 3.1415926,
        "caption": "半波与 x 轴围成的面积",
        "duration": 7.5
      }
    },
    {
      "id": 3,
      "template": "step_card",
      "params": {
        "mode": "stack",
        "duration": 11.0,
        "steps": [
          {
            "text": "写出积分式",
            "formula_latex": "S = \\int_0^{\\pi} \\sin x\\, dx"
          },
          {
            "text": "求原函数，cos x 的导数是 -sin x",
            "formula_latex": "\\int \\sin x\\, dx = -\\cos x + C"
          },
          {
            "text": "代入上下限",
            "formula_latex": "S = \\left.(-\\cos x)\\right|_0^{\\pi} = -\\cos\\pi + \\cos 0"
          },
          {
            "text": "计算得面积",
            "formula_latex": "= -(-1) + 1 = 2"
          }
        ]
      }
    },
    {
      "id": 4,
      "template": "summary_card",
      "params": {
        "title": "答案",
        "points": [
          "面积 = 2",
          "注意：cos π = -1，容易漏掉负号",
          "整周期 [0, 2π] 的代数和为 0，但面积要分段取绝对值"
        ],
        "duration": 5.0
      }
    }
  ]
}
