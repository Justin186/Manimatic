{
  "title": "闭区间上的最值",
  "problem_type": "closed_interval_extremum",
  "scenes": [
    {
      "id": 1,
      "template": "title_card",
      "params": {
        "text": "求 $f(x) = x^2 - 2x - 3$ 在 $[-1, 3]$ 上的最值",
        "subtitle": "顶点落在区间内",
        "duration": 3.5
      }
    },
    {
      "id": 2,
      "template": "axes_plot",
      "params": {
        "x_range": [
          -2,
          4,
          1
        ],
        "y_range": [
          -5,
          6,
          1
        ],
        "functions": [
          {
            "expr": "x**2 - 2*x - 3",
            "label": "f(x) = x^2 - 2x - 3",
            "color": "BLUE"
          }
        ],
        "caption": "开口向上，顶点 x = 1 在区间 [-1, 3] 内",
        "duration": 6.0
      }
    },
    {
      "id": 3,
      "template": "step_card",
      "params": {
        "mode": "stack",
        "duration": 11.0,
        "steps": [
          {
            "text": "配方，找顶点",
            "formula_latex": "f(x) = (x-1)^2 - 4"
          },
          {
            "text": "顶点在区间内，最小值在顶点取得",
            "formula_latex": "f(1) = -4"
          },
          {
            "text": "再比较两端点",
            "formula_latex": "f(-1) = 0,\\quad f(3) = 0"
          },
          {
            "text": "最大值在两个端点同时取得",
            "formula_latex": "\\max = 0,\\quad \\min = -4"
          }
        ]
      }
    },
    {
      "id": 4,
      "template": "summary_card",
      "params": {
        "title": "答案",
        "points": [
          "最小值 -4（在 x = 1）",
          "最大值 0（在 x = -1 和 x = 3）",
          "注意：最值要同时看顶点和端点"
        ],
        "duration": 4.5
      }
    }
  ]
}