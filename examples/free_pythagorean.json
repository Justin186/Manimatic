          "id": "n_b",
          "kind": "text",
          "content": "$16$",
          "font_size": 34,
          "color": "TEAL",
          "place": [{ "at_point": [-4.6, -0.4] }]
        },
        {
          "id": "n_c",
          "kind": "text",
          "content": "$25$",
          "font_size": 34,
          "color": "GOLD",
          "place": [{ "at_point": [-1.3, 0.5] }]
        },
        {
          "id": "eq",
          "kind": "formula",
          "content": "9 + 16 = 25",
          "font_size": 40,
          "color": "ACCENT",
          "place": [{ "corner": "ur", "buff": 0.9 }]
        },
        {
          "id": "lg",
          "kind": "legend",
          "items": [["GREEN", "$a^2$"], ["TEAL", "$b^2$"], ["GOLD", "$c^2$"]],
          "font_size": 20,
          "place": [{ "next_to": { "of": "eq", "direction": "down", "buff": 0.35, "aligned": "right" } }]
        },
        {
          "id": "cap",
          "kind": "text",
          "content": "两个小正方形的面积之和，正好等于大正方形",
          "font_size": 25,
          "color": "WHITE",
          "place": [{ "edge": "down", "buff": 0.4 }]
        }
      ],
      "timeline": [
        { "do": "create", "target": "tri", "run_time": 0.8 },
        { "do": "draw_border", "target": "sq_a", "run_time": 1.3 },
        { "do": "write", "target": "n_a", "run_time": 0.7 },
        { "do": "draw_border", "target": "sq_b", "run_time": 1.3 },
        { "do": "write", "target": "n_b", "run_time": 0.7 },
        { "do": "draw_border", "target": "sq_c", "run_time": 1.5 },
        { "do": "write", "target": "n_c", "run_time": 0.7 },
        { "do": "fade_in", "target": "lg", "run_time": 0.6 },
        { "do": "write", "target": "eq", "run_time": 1.2 },
        { "do": "write", "target": "cap", "run_time": 1.0 },
        { "do": "indicate", "target": "eq", "run_time": 1.1 },
        { "do": "wait", "time": 1.2 }
      ]
    },

    {
      "id": 4,
      "duration": 6.0,
      "elements": [
        {
          "id": "th",
          "kind": "text",
          "content": "结论",
          "font_size": 38,
          "color": "PRIMARY",
          "place": [{ "edge": "up", "buff": 1.4 }]
        },
        { "id": "s1", "kind": "text", "content": "直角三角形两直角边的平方和等于斜边的平方", "font_size": 28 },
        { "id": "s2", "kind": "text", "content": "$a^2 + b^2 = c^2$，与三角形的大小无关", "font_size": 28, "color": "SECONDARY" },
        {
          "id": "grp",
          "kind": "group",
          "items": ["s1", "s2"],
          "direction": "down",
          "buff": 0.6,
          "aligned": "left",
          "place": [{ "next_to": { "of": "th", "direction": "down", "buff": 0.9 } }]
        },
        { "id": "box", "kind": "highlight", "of": "grp", "color": "ACCENT", "buff": 0.3 }
      ],
      "timeline": [
        { "do": "write", "target": "th", "run_time": 1.0 },
        { "do": "write", "target": "grp", "run_time": 2.2, "lag_ratio": 0.6 },
        { "do": "create", "target": "box", "run_time": 0.7 },
        { "do": "wait", "time": 1.4 }
      ]
    }
  ]
}
