{
  "title": "指数函数的翻折与平移",
  "problem_type": "function_transform",
  "scenes": [
    {
      "id": 1,
      "template": "title_card",
      "params": {
        "text": "y = 2^x 经过怎样的变换得到 y = 2^(-x+1) - 1",
        "subtitle": "翻折加平移",
        "duration": 3.5
      }
    },
    {
      "id": 2,
      "template": "function_transform",
      "params": {
        "x_range": [-3, 4, 1],
        "y_range": [-2, 8, 1],
        "from_expr": "2**x",
        "to_expr": "2**(-x+1) - 1",
        "from_label": "y = 2^x",
        "to_label": "y = 2^{-x+1} - 1",
        "caption": "蓝线递增，黄线递减，渐近线从 y = 0 移到 y = -1",
        "duration": 7.5
      }
    },
    {
      "id": 3,
      "template": "step_card",
      "params": {
        "mode": "stack",
        "duration": 11.0,
        "steps": [
          {
            "text": "x 换成 -x，图像关于 y 轴翻折",
            "formula_latex": "y = 2^x \\ \\longrightarrow \\ y = 2^{-x}"
          },
          {
            "text": "再换成 -(x-1)，即右移 1 个单位",
            "formula_latex": "y = 2^{-x} \\ \\longrightarrow \\ y = 2^{-(x-1)} = 2^{-x+1}"
          },
          {
            "text": "整体减 1，图像下移 1 个单位",
            "formula_latex": "y = 2^{-x+1} \\ \\longrightarrow \\ y = 2^{-x+1} - 1"
          },
          {
            "text": "渐近线随之下移",
            "formula_latex": "y = 0 \\ \\longrightarrow \\ y = -1"
          }
        ]
      }
    },
    {
      "id": 4,
      "template": "summary_card",
      "params": {
        "title": "答案",
        "points": [
          "关于 y 轴翻折 → 右移 1 → 下移 1",
          "渐近线 y = -1，定义域 R，值域 (-1, +∞)",
          "翻折后从增函数变为减函数"
        ],
        "duration": 5.0
      }
    }
  ]
}
